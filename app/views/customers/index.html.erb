<header class="app-header">
  <div class="header-left"></div>
  
  <h1 class="header-title">顧客リスト</h1>
  
  <div class="header-right">
    <%= link_to '設定(パスワード変更)', edit_user_registration_path, style: "margin-right: 15px; color: white; font-size: 14px;" %>
    <%= button_to 'ログアウト', destroy_user_session_path, method: :delete, class: "btn-logout" %>
  </div>
</header>

<main class="customer-list-area">
  
  <div class="sort-buttons" style="margin-bottom: 20px; text-align: center;">
    <%= link_to '名前順', customers_path(sort: 'name'), style: "padding: 8px 16px; margin-right: 10px; background-color: #f0f0f0; border-radius: 20px; text-decoration: none; color: #333; border: 1px solid #ccc;" %>
    <%= link_to '年齢順', customers_path(sort: 'age'), style: "padding: 8px 16px; background-color: #f0f0f0; border-radius: 20px; text-decoration: none; color: #333; border: 1px solid #ccc;" %>
  </div>

  <% @customers.each do |customer| %>
    
    <div class="customer-card">
      <%= link_to customer_path(customer), class: "card-link" do %>
        
        <h2 class="customer-name"><%= customer.name %></h2>
        
        <p class="customer-details">
          🏠 住所: <%= customer.address %><br>
          💼 加入商品: <%= customer.product %><br>
          📈 状態: <%= customer.status %>
        </p>

      <% end %>
    </div>

  <% end %>
</main>

<%= link_to '＋ 新規登録', new_customer_path, class: "btn-floating-new" %>