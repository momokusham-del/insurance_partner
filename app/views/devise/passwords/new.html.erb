<h2 style="text-align: center; margin-bottom: 20px;">パスワード再設定</h2>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field" style="margin-bottom: 25px;">
    <%= f.label :email, "登録しているメールアドレス" %><br />
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input", style: "width: 100%; padding: 8px; box-sizing: border-box;" %>
  </div>

  <div class="actions" style="text-align: center;">
    <%= f.submit "再設定メールを送信する", class: "btn-submit", style: "background-color: #ffc107; color: #333; padding: 10px 20px; border: none; border-radius: 4px; cursor: pointer; width: 100%; font-size: 16px; font-weight: bold;" %>
  </div>
<% end %>

<div style="margin-top: 20px; text-align: center; font-size: 14px;">
  <%= render "devise/shared/links" %>
</div>