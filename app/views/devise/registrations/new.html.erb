<h2 style="text-align: center; margin-bottom: 20px;">新規登録</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field" style="margin-bottom: 15px;">
    <%= f.label :email, "メールアドレス" %><br />
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input", style: "width: 100%; padding: 8px; box-sizing: border-box;" %>
  </div>

  <div class="field" style="margin-bottom: 15px;">
    <%= f.label :password, "パスワード" %>
    <% if @minimum_password_length %>
    <em style="font-size: 12px; color: #666;">(<%= @minimum_password_length %>文字以上)</em>
    <% end %><br />
    <%= f.password_field :password, autocomplete: "new-password", class: "form-input", style: "width: 100%; padding: 8px; box-sizing: border-box;" %>
  </div>

  <div class="field" style="margin-bottom: 25px;">
    <%= f.label :password_confirmation, "パスワード（確認用）" %><br />
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-input", style: "width: 100%; padding: 8px; box-sizing: border-box;" %>
  </div>

  <div class="actions" style="text-align: center;">
    <%= f.submit "登録する", class: "btn-submit", style: "background-color: #28a745; color: white; padding: 10px 30px; border: none; border-radius: 4px; cursor: pointer; width: 100%; font-size: 16px;" %>
  </div>
<% end %>

<div style="margin-top: 20px; text-align: center; font-size: 14px;">
  <%= render "devise/shared/links" %>
</div>