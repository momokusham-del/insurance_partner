<h2>パスワード変更・アカウント編集</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field" style="margin-bottom: 15px;">
    <%= f.label :email, "ログイン用メールアドレス" %><br />
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input" %>
  </div>

  <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
    <div>現在、以下のメールアドレスの確認待ちです: <%= resource.unconfirmed_email %></div>
  <% end %>

  <div class="field" style="margin-bottom: 15px;">
    <%= f.label :password, "新しいパスワード" %> <i>(変更しない場合は空欄のままでOK)</i><br />
    <%= f.password_field :password, autocomplete: "new-password", class: "form-input", placeholder: "6文字以上で入力してください" %>
  </div>

  <div class="field" style="margin-bottom: 15px;">
    <%= f.label :password_confirmation, "新しいパスワード（確認用）" %><br />
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-input" %>
  </div>

  <div class="field" style="margin-bottom: 25px;">
    <%= f.label :current_password, "現在のパスワード（必須）" %> <i>(変更を確定するために今のパスワードを入力してください)</i><br />
    <%= f.password_field :current_password, autocomplete: "current-password", class: "form-input" %>
  </div>

  <div class="actions">
    <%= f.submit "変更を保存する", class: "btn-submit", style: "background-color: #28a745; color: white; padding: 10px 20px; border: none; border-radius: 4px; cursor: pointer;" %>
  </div>
<% end %>

<hr style="margin: 40px 0;">

<p style="text-align: center;">
  <%= link_to "戻る", :back, style: "color: #666;" %>
</p>