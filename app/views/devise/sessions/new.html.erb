<h2 style="text-align: center; margin-bottom: 20px;">ログイン</h2>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="form-group" style="margin-bottom: 15px;">
    <%= f.label :email, "メールアドレス" %><br />
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input", style: "width: 100%; padding: 8px; box-sizing: border-box;" %>
  </div>

  <div class="form-group" style="margin-bottom: 15px;">
    <%= f.label :password, "パスワード" %><br />
    <%= f.password_field :password, autocomplete: "current-password", class: "form-input", style: "width: 100%; padding: 8px; box-sizing: border-box;" %>
  </div>

  <% if devise_mapping.rememberable? %>
    <div class="form-group" style="margin-bottom: 20px;">
      <%= f.check_box :remember_me %>
      <%= f.label :remember_me, "次回から自動的にログインする" %>
    </div>
  <% end %>

  <div class="form-actions" style="text-align: center;">
    <%= f.submit "ログインする", class: "btn-submit", style: "background-color: #007bff; color: white; padding: 10px 30px; border: none; border-radius: 4px; cursor: pointer; width: 100%; font-size: 16px;" %>
  </div>
<% end %>

<div style="margin-top: 30px; text-align: center; font-size: 14px;">
  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <%= link_to "新規登録はこちら", new_registration_path(resource_name), style: "color: #007bff; text-decoration: none;" %><br /><br />
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <%= link_to "パスワードを忘れた方はこちら", new_password_path(resource_name), style: "color: #007bff; text-decoration: none;" %><br />
  <% end %>
</div>